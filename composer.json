{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.0",
        "darkaonline/l5-swagger": "^11.0",
        "eclipxe/sepomexphp": "^4.0",
        "fakerphp/faker": "^1.24",
        "google/apiclient": "^2.0",
        "guzzlehttp/guzzle": "^7.9",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/framework": "^12.0",
        "laravel/jetstream": "^5.3",
        "laravel/reverb": "^1.10.2",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.24",
        "laravel/tinker": "^3.0",
        "maatwebsite/excel": "^3.1",
        "masbug/flysystem-google-drive-ext": "^2.5",
        "owen-it/laravel-auditing": "^14.0",
        "php-extended/php-api-nz-mega-object": "^9.0",
        "phpcfdi/sat-ws-descarga-masiva": "^1.1",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-permission": "^7.0",
        "symfony/browser-kit": "^7.1",
        "symfony/http-client": "^7.1",
        "tightenco/ziggy": "^2.5",
        "jesusaln/cdd-shared": "@dev"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:jesusaln/cdd-shared.git"
        }
    ],
    "require-dev": {
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.1",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fdba74,#8b5cf6\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"npm run dev\" \"php artisan reverb:start\" --names='server,queue,vite,reverb'"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/pail"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "laravel/horizon": "Panel y métricas para colas Redis en producción (supervisión de backups, SAT, WhatsApp)."
    }
}
