{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && rm -f public/build/manifest.json && ln -s .vite/manifest.json public/build/manifest.json && rm -f public/sw.js public/workbox-*.js && cp public/build/sw.js public/sw.js && cp public/build/workbox-*.js public/",
    "dev": "vite",
    "ionic:build": "npm run build",
    "ionic:serve": "npm run dev",
    "laravel": "php -d post_max_size=100M -d upload_max_filesize=100M artisan serve --host=0.0.0.0 --port=8001",
    "laravel:vite": "php -d post_max_size=100M -d upload_max_filesize=100M artisan serve --host=0.0.0.0 --port=8001",
    "start": "php artisan config:clear && php artisan optimize:clear && concurrently \"npm run laravel\" \"npm run dev\" \"npm run ionic\" \"php artisan reverb:start\"",
    "ionic": "npm run dev --prefix ../ionic-frontend",
    "serve": "php -d post_max_size=100M -d upload_max_filesize=100M artisan serve --host=0.0.0.0 --port=8001",
    "laravel-only": "php -d post_max_size=100M -d upload_max_filesize=100M artisan serve --host=0.0.0.0 --port=8001",
    "watch": "vite build --watch",
    "production": "npm run build && npm run laravel-only",
    "test": "php artisan test",
    "build:safe": "./scripts/version-build.sh --build",
    "deploy": "./scripts/version-build.sh --build",
    "rollback": "./scripts/version-build.sh --rollback"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^2.3.25",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.16",
    "axios": "^1.6.0",
    "concurrently": "^8.2.2",
    "idb-keyval": "^6.2.2",
    "laravel-echo": "^2.3.4",
    "laravel-vite-plugin": "^1.0.0",
    "postcss": "^8.4.32",
    "pusher-js": "^8.5.0",
    "tailwindcss": "^4.3.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.2.0",
    "vue": "^3.3.13"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@unhead/vue": "^1.9.0",
    "chart.js": "^4.5.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "form-data": "^4.0.4",
    "jspdf": "^4.1.0",
    "lightweight-charts": "^5.2.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "notyf": "^3.10.0",
    "quill": "^2.0.3",
    "sweetalert2": "^11.26.17",
    "vue-chartjs": "^5.3.3",
    "vuedraggable": "^4.1.0",
    "vuelidate": "^0.7.7",
    "ziggy-js": "^2.6.0"
  },
  "name": "my-app",
  "version": "0.0.0"
}
